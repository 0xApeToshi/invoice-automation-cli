# .env.example
# Copy this file to .env and fill in your actual credentials
# Never commit .env files to version control

# =============================================================================
# META ADS CONFIGURATION
# =============================================================================
# Get these from Meta Business Manager (business.facebook.com)
# Requires Finance role and Business Manager Owned Normal Credit Line

# Your Meta Business Manager ID (numeric string)
META_BUSINESS_ID=your_business_id_here

# Graph API access token with Finance permissions
META_ACCESS_TOKEN=your_access_token_here

# Meta API version to use (default: v21.0)
META_API_VERSION=v21.0

# =============================================================================
# GOOGLE ADS CONFIGURATION
# =============================================================================
# Requires Google Ads account with monthly invoicing (not automatic payments)
# Use 'invoice-automation generate-tokens --provider google' to get OAuth2 credentials

# Your Google Ads customer ID (10 digits, without hyphens)
GOOGLE_CUSTOMER_ID=your_customer_id_here

# OAuth2 client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_client_id_here

# OAuth2 client secret from Google Cloud Console
GOOGLE_CLIENT_SECRET=your_client_secret_here

# OAuth2 refresh token (generated via token command)
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Google Ads developer token (from Google Ads API access)
GOOGLE_DEVELOPER_TOKEN=your_developer_token_here

# =============================================================================
# GOOGLE DRIVE CONFIGURATION (Optional)
# =============================================================================
# Enable Google Drive uploads for automatic invoice syncing
# Use 'invoice-automation generate-tokens --provider google-drive' to get credentials

# Enable/disable Google Drive functionality
GOOGLE_DRIVE_ENABLED=true

# OAuth2 credentials for Google Drive API
# Note: These can be the same as Google Ads credentials if using 'both' provider
GOOGLE_DRIVE_CLIENT_ID=your_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret_here
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here

# Optional: Specific Google Drive folder ID to upload to
# If not set, uploads to root directory
# GOOGLE_DRIVE_FOLDER_ID=1A2B3C4D5E6F7G8H9I0J

# Folder organization method: date, client, provider, flat
GOOGLE_DRIVE_FOLDER_STRUCTURE=client

# Whether to overwrite existing files (true/false)
GOOGLE_DRIVE_OVERWRITE_EXISTING=false

# Default sharing permissions for uploaded files: none, view, edit
GOOGLE_DRIVE_SHARE_PERMISSIONS=none

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Local directory for storing downloaded invoices
OUTPUT_DIR=./invoices

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Retry configuration for API calls
MAX_RETRIES=3
RETRY_DELAY=1.0
TIMEOUT_SECONDS=30

# Development settings
DEBUG=false

# =============================================================================
# GETTING STARTED
# =============================================================================
# 
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. For Google services, generate OAuth2 tokens:
#    python -m src.main generate-tokens --provider both
#
# 3. Fill in the credentials above with your actual values
#
# 4. For Meta Ads, get credentials from:
#    https://business.facebook.com/
#
# 5. For Google Ads developer token, apply at:
#    https://developers.google.com/google-ads/api/
#
# 6. Test your configuration:
#    python -m src.main status --verbose
#
# 7. Fetch invoices:
#    python -m src.main fetch
#
# 8. Upload to Google Drive (if enabled):
#    python -m src.main upload --dry-run
#
# =============================================================================
